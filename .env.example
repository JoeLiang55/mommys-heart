# Azure OpenAI (used by the RAG chat API and by AI reports)
#
#   AZURE_OPENAI_CHAT_DEPLOYMENT    answers the document chatbot
#   AZURE_OPENAI_REPORT_DEPLOYMENT  builds AI reports (/reports). Writing SQL
#                                   against an unfamiliar schema wants a
#                                   stronger model than the chatbot does, so
#                                   this is configured separately. Reasoning
#                                   deployments (gpt-5*, o1/o3/o4) are detected
#                                   from the name and called accordingly.
#
# Without these, /reports explains it is not configured rather than failing.
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_REPORT_DEPLOYMENT=gpt-5.6-sol
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure Communication Services (ACS) Email. 
#
#   ACS_EMAIL_ENDPOINT       the resource endpoint, e.g.
#                            https://your-resource.communication.azure.com
#   ACS_EMAIL_ACCESS_KEY     the resource's base64 access key (from the
#                            connection string's `accesskey=` component)
#   ACS_EMAIL_SENDER_ADDRESS a verified sender, e.g.
#                            DoNotReply@your-domain.azurecomm.net
ACS_EMAIL_ENDPOINT=
ACS_EMAIL_ACCESS_KEY=
ACS_EMAIL_SENDER_ADDRESS=

# Branding + links shared by every email template.
BRAND_NAME=Mommy's Heart
APP_URL=
SUPPORT_EMAIL=

# EMAIL_DRY_RUN — when true, case-activity notifications are NOT actually sent;
# the server logs what it *would* have sent instead. Keep this `true` for local
# development/testing so you don't email real users; set it to `false` (or leave
# it unset) in production to send for real.
#
# To preview how the emails *look* without any email service, database, or web
# server, render every template to standalone HTML files you can open in a
# browser:  `cargo run --features ssr -- preview-emails` (writes to
# target/email-preview/, open index.html).
# Truthy values: true, 1, yes, on (case-insensitive).
EMAIL_DRY_RUN=true

# Comma-separated browser origins allowed to call the API (CORS). Must include
# the Squarespace site that embeds the chat widget. Use "*" to allow any origin.
ALLOWED_ORIGINS=*

# Cloudflare Turnstile CAPTCHA secret (optional). When set, /api/chat requires a
# valid Turnstile token verified server-side. Leave empty to disable.
TURNSTILE_SECRET_KEY=

# PostgreSQL connection string used by the SSR backend to persist application data
# (users, cases, grants, messages, audit logs). Locally you can leave
# this unset: Kingdom raises the shared database declared in
# .kingdom/services.toml and the app defaults to the URL below. In production,
# point this at your Azure Database for PostgreSQL server (it is required there).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Runtime mode. Production enables fail-closed configuration validation, secure
# cookies and transport headers, strict Origin checks, and MFA.
APP_ENV=development

# ── Case documents (SharePoint via Microsoft Graph) ─────────────────────────
# Case files live in a SharePoint document library, reached with an app-only
# (client credentials) Microsoft Graph token. The database keeps only a pointer
# to each case's folder and a record of the sharing invitations issued on it.
#
# Local development needs NONE of this: leave it unset and case documents use an
# on-disk store under target/sharepoint/, which supports the whole feature —
# browsing, upload, download, and grant/revoke — with no Microsoft tenant.
# Set SHAREPOINT_BACKEND=local to choose that explicitly and silence the
# startup notice.
SHAREPOINT_BACKEND=local
#
# For a real library, a Microsoft 365 tenant admin does this once:
#
#   1. Register an application in Microsoft Entra ID; note its Directory
#      (tenant) ID and Application (client) ID, and create a client secret.
#   2. On that registration add the *Application* (not Delegated) Graph
#      permissions `Files.ReadWrite.All` and `Sites.ReadWrite.All`, then click
#      "Grant admin consent". Delegated permissions will not work: the app acts
#      as itself, not on behalf of a signed-in person.
#   3. Note the URL of the SharePoint site holding the library.
#   4. To invite clients — who are not members of the tenant — enable external
#      sharing on that site. Without it, staff invitations still work and the
#      in-app view still works for everyone; only a client's own SharePoint
#      access is unavailable.
#
# GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
# GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# GRAPH_CLIENT_SECRET=your-client-secret
# SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/CaseFiles
#
# The document library's display name within that site.
SHAREPOINT_LIBRARY=Documents
#
# The folder inside the library under which every case folder is created.
SHAREPOINT_ROOT_FOLDER=Cases
#
# The folder inside the library under which each volunteer's own folder (and
# their resume) is created. A sibling of the case root, never inside it.
SHAREPOINT_VOLUNTEER_ROOT_FOLDER=Volunteers

# Logging verbosity (tracing/env-filter syntax). Unset uses a developer-friendly
# default that shows API requests and database operations. Examples:
#   RUST_LOG=warn                     -> warnings + errors only
#   RUST_LOG=info                     -> app events + API requests (no SQL)
#   RUST_LOG=debug                    -> everything, including each SQL statement
#   RUST_LOG="info,sqlx::query=debug" -> API events plus SQL only
RUST_LOG=info
